# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it is already covered by .gitignore.

# --- General ---
ENV=development

# --- Database (PostgreSQL) ---
# Local: postgresql+psycopg2://postgres:postgres@localhost:5432/lexora
# Docker: postgresql+psycopg2://postgres:postgres@db:5432/lexora
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/lexora

# --- JWT ---
# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Google OAuth 2.0 ---
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- Google Gemini API ---
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- Google Books API ---
# https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=your-google-books-api-key

# --- URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
