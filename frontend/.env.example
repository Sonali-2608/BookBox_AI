# Copy this file to .env in this frontend/ folder and fill in real values.
# Vite only exposes vars prefixed with VITE_ to client-side code, and only
# reads .env from this directory (not the project root).

# The backend API base URL. In dev, Vite already proxies /api to
# http://localhost:8000 (see vite.config.js), so you can usually leave
# this as /api. Set it explicitly for a deployed backend.
VITE_API_BASE_URL=/api

# Same Google OAuth client ID configured in the backend's .env
# (https://console.cloud.google.com/apis/credentials). Must be an
# "OAuth 2.0 Client ID" of type "Web application" with this app's
# origin (e.g. http://localhost:5173) under "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
